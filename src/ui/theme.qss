/* FARMEYE™ AI — Premium operations console */
* {
  font-family: "Segoe UI", "Bahnschrift", "Inter", sans-serif;
  color: #e7edf4;
}

QMainWindow, QWidget#centralRoot {
  background: qlineargradient(x1:0, y1:0, x2:0.6, y2:1,
    stop:0 #06090e, stop:0.45 #0b121a, stop:1 #081018);
}

QLabel#brandMark {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #2bb673, stop:1 #1a7a4a);
  color: #ffffff;
  font-size: 18px;
  font-weight: 800;
  border-radius: 10px;
  padding: 6px 11px;
  min-width: 28px;
}

QLabel#brandLabel {
  font-size: 24px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1.5px;
}

QLabel#sectionTitle {
  font-size: 11px;
  font-weight: 800;
  color: #7f93a8;
  letter-spacing: 1.4px;
}

QLabel#subSection {
  font-size: 10px;
  font-weight: 700;
  color: #5f7388;
  letter-spacing: 1px;
}

QLabel#sysClock {
  font-size: 15px;
  font-weight: 700;
  color: #f0f4f8;
  letter-spacing: 0.5px;
}

QLabel#metricName {
  font-size: 9px;
  font-weight: 800;
  color: #7a8fa3;
  letter-spacing: 1px;
}

QLabel#metricValue {
  font-size: 13px;
  font-weight: 700;
  color: #e8eef5;
}

QFrame#panel, QFrame#topBar, QFrame#bottomBar {
  background-color: rgba(14, 20, 28, 240);
  border: 1px solid rgba(100, 120, 145, 55);
  border-radius: 18px;
}

QFrame#ctrlBox {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #15202c, stop:1 #101820);
  border: 1px solid rgba(90, 115, 140, 70);
  border-radius: 14px;
}

QFrame#videoFrame {
  background-color: #03060a;
  border: 1px solid rgba(90, 110, 135, 45);
  border-radius: 18px;
}

QFrame#metricChip {
  background: rgba(20, 30, 42, 220);
  border: 1px solid rgba(80, 100, 125, 70);
  border-radius: 12px;
}

QFrame#alertShell {
  background: rgba(10, 14, 20, 160);
  border: 1px solid rgba(70, 90, 110, 50);
  border-radius: 14px;
}

QPushButton#btnStart {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2ecc71, stop:1 #1e9e52);
  border: 1px solid #45e08a;
  border-radius: 12px;
  padding: 16px 10px;
  min-height: 48px;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.8px;
  color: #ffffff;
}
QPushButton#btnStart:hover {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #3adb80, stop:1 #24b05c);
}
QPushButton#btnStart:disabled {
  background: #1a2a22;
  border-color: #2a3a32;
  color: #6a7a70;
}

QPushButton#btnPause {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #5a2228, stop:1 #3a1518);
  border: 1px solid #c24a4a;
  border-radius: 12px;
  padding: 16px 10px;
  min-height: 48px;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 0.8px;
  color: #ffd6d6;
}
QPushButton#btnPause:hover {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #7a2e34, stop:1 #4a1c20);
}
QPushButton#btnPause:disabled {
  background: #1c1618;
  border-color: #3a2a2c;
  color: #6a5558;
}

QPushButton#btnClip {
  background: rgba(12, 18, 26, 230);
  border: 1px solid #4a5e75;
  border-radius: 9px;
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 800;
}
QPushButton#btnClip:hover {
  border-color: #6eb0ff;
  color: #ffffff;
  background: #162230;
}

QPushButton#btnPc {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2a3848, stop:1 #1c2834);
  border: 1px solid #4a5e75;
  border-radius: 12px;
  padding: 12px 16px;
  font-weight: 700;
}

QPushButton {
  background-color: #243041;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 8px 12px;
}
QPushButton:hover { background-color: #2d3c50; }

QListWidget#alertList {
  background: transparent;
  border: none;
  outline: none;
  padding: 4px;
}
QListWidget#alertList::item {
  background: transparent;
  padding: 0px;
  margin: 0px;
}
QListWidget#alertList::item:selected { background: transparent; }

QComboBox {
  background-color: #15202c;
  border: 1px solid #3d5168;
  border-radius: 10px;
  padding: 10px 14px;
  min-width: 110px;
  font-weight: 600;
}
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
  background: #15202c;
  border: 1px solid #3d5168;
  selection-background-color: #243548;
}

QLabel#aiActive {
  color: #3dd68c;
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 0.6px;
  padding-top: 4px;
}

QLabel#emptyHint {
  color: #6d8094;
  font-size: 12px;
  padding: 18px;
}

QLabel#legendChip {
  font-size: 10px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 8px;
}

QScrollBar:vertical {
  background: transparent;
  width: 7px;
  margin: 6px 2px;
}
QScrollBar::handle:vertical {
  background: #2c3c4e;
  border-radius: 3px;
  min-height: 28px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
